# Copy to apps/backend/.env. Never commit the real file.
# Load the unpacked extension first; copy its exact origin from Observe Settings.
OBSERVE_EXTENSION_ORIGIN=chrome-extension://REPLACE_WITH_EXTENSION_ID

# Explicit owner-selected model supporting Chat Completions + strict JSON schema.
# No model or credentials are assumed and no unrelated project secrets are read.
OPENAI_MODEL=
OPENAI_API_KEY=

# Set only after approving the provider's applicable account data-handling terms.
PROVIDER_TERMS_ACKNOWLEDGED=false

# Required positive USD limits and CURRENT rates for the chosen model/account.
# Values deliberately blank: no spend is authorized by this example.
MAX_REQUEST_USD=
MAX_DAILY_USD=
INPUT_USD_PER_MILLION_TOKENS=
OUTPUT_USD_PER_MILLION_TOKENS=
MAX_OUTPUT_TOKENS=2500

# TypeSafe Jev (https://docs.typesafe.ai). While recording, the extension sends minimized
# episode data here for live decisions: action classification, content relevance,
# task-boundary suggestions, and same-task matching. Leave the key blank to disable.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Required positive daily input-token cap (about $0.042 per million tokens at list price).
# Always-on recording uses roughly 0.5-1M tokens per active hour.
JEV_MAX_DAILY_TOKENS=20000000
